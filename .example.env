
TORI_APP_NAME="AWEN - Graph Based Entity Management"
TORI_APP_DESCRIPTION="Entity Management for Graph Applications using the RAMEN-Framework"
TORI_APP_FAVICON="/favicon-default.jpg" # optional
TORI_APP_HOST="https://example.com"
TORI_APP_PREFIX="/em" # optional

TORI_GCORE="/tori-config/gcore.json"
TORI_GCORE_RAMEN="/tori-config/ramen.gcore.json"
#TORI_GCORE_RAMEN="https://raw.githubusercontent.com/THM-Graphs/ATAG-Editor-Guidlines/refs/heads/main/ramen.gcore.json"
#TORI_GCORE_PROJECT="/tori-config/regesta-imperii.gcore.json"
TORI_GCORE_PROJECT="/tori-config/abbw.gcore.json"

# TORI_SERVER_PORT=3000 # optional | default: 3000

# Connection to the neo4j instance; these values fit the neo4j service of compose.yml
# (without Docker: TORI_DB_HOST="localhost")
TORI_DB_HOST="neo4j"
TORI_DB_PASSWORD="neo4jadmin"
TORI_DB_PORT=7687
TORI_DB_USER="neo4j"
TORI_DB_SCHEME="bolt" # "neo4j", "neo4j+s", "bolt", "bolt+s"
TORI_DB_NAME="neo4j" # optional | default: "neo4j"

# SQLite user database; compose.yml mounts ./user-db as /user-db
# TORI_USER_DB_NAME="/user-db/user.db" # optional | compose default: /user-db/user.db
# TORI_USER_DB_SYNCHRONIZE=true # optional | compose default: true (creates the tables, there are no migrations); server default: false

TORI_MISO_HOST="https://miso.example.com" # optional
